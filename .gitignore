# macOS
.DS_Store
**/.DS_Store

# Claude Code — local/machine-specific settings
.claude/settings.local.json

# Backups gerados automaticamente
.claude.bak-*/

# Skills dependencies (like node_modules — restored via `npx skills install`)
.agents/

# Smart-memory — project-specific context, not for the public repo
docs/smart-memory/

# Environment variables — never commit credentials
.env
.env.*
!.env.example


# macOS — ícones custom de pasta (Icon\r): nunca versionar
Icon?
**/Icon?

# Artefatos do skills.sh CLI (npx skills add) — só .claude/skills/ é fonte
skills-lock.json
.commandcode/
.devin/

# claude-seo runtime — criado por `/seo setup` em cada máquina/projeto via
# CLAUDE_SEO_PYTHON; nunca versionar (venv já tem .gitignore próprio, mas o
# Chromium baixado pelo Playwright e o estado local não têm)
.claude/skills/seo/.venv/
.claude/skills/seo/ms-playwright/
.claude/skills/seo/runtime-state.json
.factory/
.grok/
.hermes/
.pi/
.trae/
.cursor/
.windsurf/
.codex/
.gemini/
.opencode/

# Raiz dos projetos destino (por máquina) — usado por scan-ct-projects.sh/dashboard.sh
.team-os-root

# Python
__pycache__/
*.pyc
